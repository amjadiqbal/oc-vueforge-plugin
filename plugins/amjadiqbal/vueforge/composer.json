{
    "name": "amjadiqbal/vueforge",
    "type": "october-plugin",
    "description": "The rapid Vue 3 component & widget engine for October CMS backend interfaces.",
    "keywords": ["october cms", "vue", "vue3", "form widget", "backend"],
    "license": "MIT",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://github.com/amjadiqbal"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\VueForge\\": ""
        }
    },
    "extra": {
        "installer-name": "vueforge"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
